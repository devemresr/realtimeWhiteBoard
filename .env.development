NODE_ENV=development

# Server
PORT=3001
MONGODB_URI=mongodb://localhost:27017/myapp_dev?replicaSet=rs0&directConnection=true

# Redis - app state
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis - Socket.IO adapter
REDIS_ADAPTER_HOST=localhost
REDIS_ADAPTER_PORT=6380

# Secrets - fill these in locally 
SOCKET_IO_ADMIN_PASSWORD=changeme
ACCESS_TOKEN_SECRET=dev-access-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret

# For playwright tests
# NOTE:
# We use 127.0.0.1 instead of localhost to force IPv4 resolution.
# This avoids Socket.IO connection issues caused by environments where
# 'localhost' resolves to IPv6 (::1), which may not match the server binding.
BASE_URL=http://127.0.0.1:3001
TEST_DATABASE_URL=mongodb://localhost:27017/canvas_dev

# grafana secrets
GF_SECURITY_ADMIN_USER=changeme
GF_SECURITY_ADMIN_PASSWORD=changeme
GF_USERS_ALLOW_SIGN_UP=changeme