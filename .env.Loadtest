# used for jest tests since the server is not run inside docker these values overwrite the default values pointing at the right ports for tests

PORT=3020 # so we can run dev and test environment at the same time since theres no containers of the app needed

MONGODB_URI=mongodb://localhost:27018/myapp_dev?replicaSet=rs0&directConnection=true


# Redis - app state
REDIS_HOST=127.0.0.1
REDIS_PORT=6381

# Redis - Socket.IO adapter
REDIS_ADAPTER_HOST=localhost
REDIS_ADAPTER_PORT=6382

NODE_ENV=loadTest