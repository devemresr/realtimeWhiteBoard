{
	"name": "finalproject",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"shared"
	],
	"scripts": {
		"infra:up": "docker compose -f docker-compose.infra.yml up -d",
		"infra:down": "docker compose -f docker-compose.infra.yml down",
		"server:dev": "nodemon --exec \"tsx --tsconfig ./server/tsconfig.json\" --env-file=.env.development --env-file=.env.local server/index.ts",
		"client:dev": "next dev ./client",
		"dev": "npm run infra:up && concurrently \"npm run server:dev\" \"npm run client:dev\"",
		"check:server": "tsc --project server/tsconfig.json --noEmit && eslint server/ shared/ --ext .ts,.js",
		"check:client": "tsc --project client/tsconfig.json --noEmit && eslint client/ shared/ --ext .ts,.tsx,.js,.jsx",
		"docker:prod": "docker compose --env-file .env.production up --build",
		"docker:stop": "docker compose down"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.4.2",
		"nodemon": "^3.1.10",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"artillery": "^2.0.21",
		"eslint": "^9.39.4",
		"next": "^16.2.4",
		"pino": "^10.3.1",
		"uuid": "^14.0.0"
	}
}
