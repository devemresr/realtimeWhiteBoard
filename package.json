{
	"name": "finalproject",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"shared"
	],
	"scripts": {
		"infra:up": "docker compose -p finalproject-dev -f docker-compose.infra.yml up -d",
		"infra:logs": "docker compose -p finalproject-dev -f docker-compose.infra.yml logs -f",
		"infra:down": "docker compose -p finalproject-dev -f docker-compose.infra.yml down",
		"infra:test": "docker compose -p finalproject-test -f docker-compose.test.infra.yml up -d",
		"infra:test:down": "docker compose -p finalproject-test -f docker-compose.test.infra.yml down",
		"prod": "docker compose -p finalproject-prod --env-file .env.production up --build -d",
		"prod:down": "docker compose -p finalproject-prod --env-file .env.production down",
		"server:dev": "nodemon --exec \"tsx --tsconfig ./server/tsconfig.json\" --env-file=.env.development  server/index.ts",
		"client:dev": "next dev ./client",
		"dev": "npm run infra:up && concurrently \"npm run server:dev\" \"npm run client:dev\"",
		"test:auth": "npm run infra:test && jest --detectOpenHandles --verbose server/tests/apiTests/auth.test.ts",
		"test:socket": "npm run infra:test && jest --detectOpenHandles --verbose server/tests/apiTests/socketAuhtorization.test.ts",
		"test:room": "npm run infra:test && jest --detectOpenHandles --verbose server/tests/apiTests/room.test.ts",
		"test:all": "npm run test:auth; npm run test:socket; npm run test:room",
		"infra:load:up": "docker compose -p finalproject-test -f docker-compose.test.infra.yml -f docker-compose.loadtest.yml up -d",
		"infra:load:up:scaled": "docker compose -p finalproject-test -f docker-compose.test.infra.yml -f docker-compose.loadtest.yml up -d --scale realtime_whiteboard=3",
		"test:load": "npm run infra:load:up && ts-node server/scripts/seedLoadTestUser.ts $NUM_ROOMS && npm run test:load:run",
		"test:load:scaled": "npm run infra:load:up:scaled && ts-node server/scripts/seedLoadTestUser.ts $NUM_ROOMS && npm run test:load:run",
		"test:load:run": "npx artillery run --output report.json client/tests/artillery/stressTest.yaml",
		"infra:load:build": "docker compose -p finalproject-test -f docker-compose.test.infra.yml -f docker-compose.loadtest.yml build",
		"test:load:fresh": "npm run infra:load:build && npm run test:load",
		"test:load:scaled:fresh": "npm run infra:load:build && npm run test:load:scaled",
		"check:server": "tsc --project server/tsconfig.json --noEmit && eslint server/ shared/ --ext .ts,.js",
		"check:client": "tsc --project client/tsconfig.json --noEmit && eslint client/ shared/ --ext .ts,.tsx,.js,.jsx"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.6.2",
		"@types/supertest": "^7.2.0",
		"artillery": "^2.0.31",
		"concurrently": "^9.2.1",
		"dotenv": "^17.4.2",
		"jsonwebtoken": "9.0.2",
		"nodemon": "^3.1.10",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0"
	},
	"dependencies": {
		"@smithy/config-resolver": "^4.5.2",
		"@smithy/middleware-retry": "^4.6.2",
		"@smithy/node-config-provider": "^4.4.2",
		"@smithy/node-http-handler": "^4.7.2",
		"@smithy/protocol-http": "^5.4.2",
		"@smithy/smithy-client": "^4.13.2",
		"@smithy/types": "^4.14.1",
		"@smithy/util-retry": "^4.4.2",
		"artillery-engine-socketio-v3": "^1.2.0",
		"axios": "^1.17.0",
		"eslint": "^9.39.4",
		"jest": "^30.4.1",
		"next": "^16.2.4",
		"pino": "^10.3.1",
		"react-icons": "^5.6.0",
		"react-toastify": "^11.1.0",
		"uuid": "^14.0.0",
		"zustand": "^5.0.14"
	}
}
