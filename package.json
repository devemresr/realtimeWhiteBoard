{
	"name": "finalproject",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"shared"
	],
	"scripts": {
		"infra:up": "docker compose -f docker-compose.infra.yml up -d",
		"infra:logs": "docker compose -f docker-compose.infra.yml logs -f",
		"infra:down": "docker compose -f docker-compose.infra.yml down",
		"infra:test": "docker compose -f docker-compose.test.infra.yml up -d",
		"infra:test:down": "docker compose -f docker-compose.test.infra.yml down",
		"server:dev": "nodemon --exec \"tsx --tsconfig ./server/tsconfig.json\" --env-file=.env.development server/index.ts",
		"client:dev": "next dev ./client",
		"dev": "npm run infra:up && concurrently \"npm run server:dev\" \"npm run client:dev\"",
		"check:server": "tsc --project server/tsconfig.json --noEmit && eslint server/ shared/ --ext .ts,.js",
		"check:client": "tsc --project client/tsconfig.json --noEmit && eslint client/ shared/ --ext .ts,.tsx,.js,.jsx",
		"docker:prod": "docker compose --env-file .env.production up --build",
		"docker:prod:down": "docker compose --env-file .env.production down",
		"test:auth": "npm run infra:test && jest --runInBand --detectOpenHandles server/tests/apiTests/auth.test.ts",
		"artillery:test": "npx artillery run --output report.json client/tests/artillery/stressTest.yaml"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.2",
		"@types/supertest": "^7.2.0",
		"artillery": "^2.0.31",
		"concurrently": "^9.2.1",
		"dotenv": "^17.4.2",
		"nodemon": "^3.1.10",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.9",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@smithy/config-resolver": "^4.5.2",
		"@smithy/middleware-retry": "^4.6.2",
		"@smithy/node-config-provider": "^4.4.2",
		"@smithy/node-http-handler": "^4.7.2",
		"@smithy/protocol-http": "^5.4.2",
		"@smithy/smithy-client": "^4.13.2",
		"@smithy/types": "^4.14.1",
		"@smithy/util-retry": "^4.4.2",
		"eslint": "^9.39.4",
		"jest": "^30.4.1",
		"next": "^16.2.4",
		"pino": "^10.3.1",
		"uuid": "^14.0.0"
	}
}
